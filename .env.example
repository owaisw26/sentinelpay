# Local-only service-to-service credential. Replace before starting Compose.
FRAUD_INTERNAL_TOKEN=replace-with-a-long-random-local-value
SENTINELPAY_LOCAL_JWT_SECRET=replace-with-at-least-32-random-characters
PSP_WEBHOOK_SECRET=replace-with-a-long-random-local-value

# Keep the contract stub for normal local development and CI.
RULE_PROPOSAL_PROVIDER=stub
OPENAI_RULE_MODEL=gpt-5.4-mini-2026-03-17

# Required only when RULE_PROPOSAL_PROVIDER=openai. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MAX_OUTPUT_TOKENS=8000
